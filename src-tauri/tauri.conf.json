{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rstris",
  "version": "0.1.0",
  "identifier": "com.fredrir.rstris",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rstris",
        "width": 1120,
        "height": 820,
        "minWidth": 900,
        "minHeight": 660,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
